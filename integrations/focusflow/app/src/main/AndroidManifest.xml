            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pen_service"/>
        </service>
        <receiver android:name=".FolioPriorityReceiver" android:exported="true"><intent-filter><action android:name="ru.folio.notes.PEN_PRIORITY_CHANGED"/></intent-filter></receiver>
        <service android:name=".AutoAdbService" android:exported="true"/>
        <provider android:name=".PenProvider" android:authorities="ru.focusflow.pen.bridge" android:exported="true" android:permission="android.permission.DUMP"/>
    </application>
</manifest>
